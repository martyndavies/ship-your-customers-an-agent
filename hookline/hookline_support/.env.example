# Hookline's Blocks API key (from the Hookline account): blocks login --write-env
BLOCKS_API_KEY=

# Where Hookline delivers Acme's webhooks (Acme on Fly.io, or http://localhost:8787/webhooks/hookline locally)
ACME_WEBHOOK_URL=https://acme-infra-demo.fly.dev/webhooks/hookline

# Name of Acme's diagnostics agent on Blocks, if you had to rename it
ACME_DIAGNOSTICS_AGENT=acme_diagnostics

# Optional LLM write-up via any OpenAI-compatible endpoint. Leave unset to use the runbook text.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
